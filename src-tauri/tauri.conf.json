{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devo-gui",
  "version": "0.1.0",
  "identifier": "com.leo.devo-gui",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "3devo Extruder",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEOEY3NzRENTQ5OUI3NjkKUldScHQ1bFVUWGVQbmVDQVpIYlNjcktKR1d6TTBFcjJ6V1BzMXpjTHNiZ2dKRTlUWFFoTk44T2MK",
      "endpoints": [
        "https://github.com/LeoLTM/3devo-gui/releases/latest/download/latest.json"
      ]
    }
  }
}